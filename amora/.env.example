# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL=postgres://user:password@host:5432/amora?sslmode=require

# Any random string of 32+ characters. Signs login sessions; keep it secret.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# From https://platform.claude.com → API keys.
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the replies (default claude-opus-5-5).
# claude-sonnet-5-5 or claude-haiku-5-5 are cheaper.
AI_MODEL=
# Optional: low | medium | high (default low; chat replies are short).
AI_EFFORT=

# Optional: free messages per user per day. Empty or 0 = unlimited.
FREE_DAILY_MESSAGE_LIMIT=

# Optional: comma-separated emails that can open /admin to add and edit companions.
ADMIN_EMAILS=
